[Unit]
Description=LumAgg Market Data Worker (testnet Soroswap)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stellar-dex-aggregator
EnvironmentFile=/opt/stellar-dex-aggregator/deploy/.env.limit-testnet.local
EnvironmentFile=/etc/lumagg/testnet-redis.env
Environment=RUST_LOG=info
ExecStart=/opt/stellar-dex-aggregator/target/release/lumagg-market-data-worker-testnet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
