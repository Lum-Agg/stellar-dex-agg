[Unit]
Description=LumAgg DEX Aggregator API (testnet Limit orders)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stellar-dex-aggregator
EnvironmentFile=/opt/stellar-dex-aggregator/deploy/.env.limit-testnet.local
Environment=LISTEN_ADDR=0.0.0.0:3200
Environment=HORIZON_URL=https://horizon-testnet.stellar.org
Environment=SNAPSHOT_BACKEND=redis
Environment=SNAPSHOT_REDIS_URL=redis://:REDISzlg153@127.0.0.1:6379/
Environment=SNAPSHOT_REDIS_CHANNEL=lumagg:snapshot:events
Environment=REFRESH_INTERVAL_SECS=30
Environment=POOL_STATE_TTL_SECS=30
Environment=RUST_LOG=info
Environment=QUOTE_RPC_HYDRATE_ENABLED=false
Environment=MAX_SPLITS=1
ExecStart=/opt/stellar-dex-aggregator/target/release/api-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
