[Unit]
Description=LumAgg Limit and DCA Keeper (testnet)
After=network.target lumagg-api-testnet.service lumagg-worker-testnet.service
Wants=lumagg-api-testnet.service lumagg-worker-testnet.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stellar-dex-aggregator
EnvironmentFile=/opt/stellar-dex-aggregator/deploy/.env.limit-testnet.local
Environment=RUST_LOG=info
ExecStart=/opt/stellar-dex-aggregator/target/release/limit-keeper-testnet --config /opt/stellar-dex-aggregator/deploy/limit-keeper-testnet.toml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
