# Shared standalone stellar-core (no local captive HTTP).
ENDPOINT=0.0.0.0:8003
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
STELLAR_CORE_URL=http://127.0.0.1:11626
STELLAR_CAPTIVE_CORE_HTTP_PORT=0
STELLAR_CAPTIVE_CORE_HTTP_QUERY_PORT=11628
CAPTIVE_CORE_CONFIG_PATH=/etc/stellar/stellar-captive-core-remote.cfg
CAPTIVE_CORE_STORAGE_PATH=/stellar/rpc-captive
DB_PATH=/stellar/stellar-rpc.sqlite
HISTORY_ARCHIVE_URLS=https://bootes-history.publicnode.org,https://lyra-history.publicnode.org,http://history.stellar.org/prd/core-live/core_live_001
HISTORY_RETENTION_WINDOW=17280
LOG_LEVEL=info
STELLAR_CORE_BINARY_PATH=/usr/bin/stellar-core
MAX_HEALTHY_LEDGER_LATENCY=168h
BACKFILL=false
