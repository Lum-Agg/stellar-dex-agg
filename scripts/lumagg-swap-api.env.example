# LumAgg Swap API all-in-one configuration.
# Copy values into your service manager or shell environment.

# Use a dedicated Stellar Soroban RPC for sustained traffic.
RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

LISTEN_ADDR=0.0.0.0:3100
AGGREGATOR_CONTRACT=CC6QAV7JEG5MYRSPO5Z65E5G2M4ZB64BEG2ZXIZXL55TQT35JDI2LC6K
RUST_LOG=lumagg_swap_api=info,api_server=info,market_data_worker=info

# Routing defaults. Requests can lower max_hops/max_splits per quote.
PATH_FINDER_MAX_HOPS=3
MAX_SPLITS=3
DISCOVERY_INTERVAL_SECS=600
REFRESH_INTERVAL_SECS=5
