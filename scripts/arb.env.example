# Copy to deploy/arb.env on the server (not committed).
#   cp scripts/arb.env.example scripts/arb.env.local   # edit locally
#   deploy_arb.sh copies scripts/arb.env.local -> server deploy/arb.env
#
# Mnemonic file must exist on server (same as legacy stellar-arb):
#   /etc/mnemonic_code.txt  (chmod 600)

# Flip to 1 after dry-run logs look good (build + simulate, no chain submit).
ARB_SUBMIT_TX=0
ARB_DRY_RUN=1
# Poll get_transaction after submit (Telegram profit stats). Default off in prod.
# ARB_POLL_TX=0

# LumAgg quote-api — arb round-robins across all instances (same as lumagg-api@3100..3103).
# Omit both vars to default to http://127.0.0.1:3100,3101,3102,3103
ARB_QUOTE_API_URLS=http://127.0.0.1:3100,http://127.0.0.1:3101,http://127.0.0.1:3102,http://127.0.0.1:3103
# Or a single instance (local dev):
# ARB_QUOTE_API_URL=http://127.0.0.1:8080

# Optional overrides (defaults are in deploy/lumagg-arb.service):
# ARB_DRY_RUN=1
# Quote-stage filter only (stroops). Fee gate is separate: submit when sim_profit >= fee.
# ARB_MIN_PROFIT=80000
# Post-fee net buffer (stroops). Gas is checked via estimated_fee; this is race/slippage margin.
# ARB_SCAN_INTERVAL_MS=500
# ARB_ITEM_GAP_MS=10
# ARB_WORKER_COUNT=4
# ARB_CALLER_COOLDOWN_MS=5000
# ARB_SLIPPAGE_BPS=0
# ARB_MAX_AMOUNT_IN=5000000000    # 500 XLM (stroops = XLM × 10^7)
# ARB_MAX_HOPS=2      # pool hops per leg; 2 enough when max_splits=1
# ARB_MAX_SPLITS=1    # 1 = no split (lower Soroban fee)
# ARB_SAMPLE_COUNT=10 # log-spaced size probes (dense small, sparse near max)
# ARB_TELEGRAM_INTERVAL_SECS=3600
#
# Quiet-window alert: opportunities keep coming but nothing prepares
# (quote vs on-chain sim gap). Defaults: 5×60s ticks, ≥50 opps/tick.
# ARB_QUIET_ALERT_TICK_SECS=60
# ARB_QUIET_ALERT_WINDOWS=5
# ARB_QUIET_ALERT_MIN_OPPS=50
# ARB_QUIET_ALERT_COOLDOWN_SECS=1800
#
# Offline quote-sim-probe timer (lumagg-quote-sim-probe.timer, every 30m):
# PROBE_SAMPLES=10
# PROBE_THRESHOLD_BPS=30
# PROBE_SIMULATE=1
#
# Telegram uses the shared deploy/telegram.env (TELEGRAM_ALERTS_ENABLED,
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) — same bot as worker/API alerts.

# Bridge tokens (comma-separated SAC contract ids). See deploy/lumagg-arb.service.
#   USDC EURC yXLM AQUA BTC SHX VELO XRP ETH yUSDC SCOP SSLX AFR BLND AVAX AUDD AUD
# Base XLM SAC: CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# Refresh candidates: python3 scripts/suggest_bridge_tokens.py --bridges "$ARB_BRIDGE_TOKENS"
# ARB_BRIDGE_TOKENS=...
