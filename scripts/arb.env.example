# Copy to deploy/arb.env on the server (not committed).
#   cp scripts/arb.env.example scripts/arb.env.local   # edit locally
#   deploy_arb.sh copies scripts/arb.env.local -> server deploy/arb.env
#
# Mnemonic file must exist on server (same as legacy stellar-arb):
#   /etc/mnemonic_code.txt  (chmod 600)

# Flip to 1 after dry-run logs look good (build + simulate, no chain submit).
ARB_SUBMIT_TX=0
ARB_DRY_RUN=1

# Optional overrides (defaults are in deploy/lumagg-arb.service):
# ARB_DRY_RUN=1
# ARB_MIN_PROFIT=100000
# ARB_SCAN_INTERVAL_MS=500
# ARB_SLIPPAGE_BPS=0
# ARB_MAX_AMOUNT_IN=180000000000

# Bridge tokens (comma-separated SAC contract ids). Default hubs in systemd unit:
