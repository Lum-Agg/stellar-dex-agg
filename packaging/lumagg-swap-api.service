[Unit]
Description=LumAgg Swap API (all-in-one)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lumagg
Group=lumagg
WorkingDirectory=/var/lib/lumagg
StateDirectory=lumagg
ExecStart=/usr/local/bin/lumagg-swap-api --config /etc/lumagg/swap-api.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
