# Complete production configuration shared by market-data-worker and api-server.
# Load it with: set -a; . ./aggregator.env; set +a
# See docs/aggregator-configuration.md for defaults and parameter details.

# Core network and logging.
RPC_URL=https://your-stellar-rpc.example.com
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
RUST_LOG=info

# Shared snapshot and pool-state storage. Keep these values identical across
# the worker and every API replica. Percent-encode Redis password characters.
LUMAGG_MODE=cluster
SNAPSHOT_BACKEND=redis
SNAPSHOT_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/
SNAPSHOT_REDIS_CHANNEL=lumagg:snapshot:events
SNAPSHOT_REDIS_KEEP_LATEST=10
SNAPSHOT_POLL_INTERVAL_MS=1000
POOL_STATE_TTL_SECS=86400
# SNAPSHOT_DIR=data/snapshots

# Market-data worker.
ENABLED_DEX_SOURCES=aquarius,aquarius_clmm,soroswap,phoenix,sushi,comet,classic_dex
DISCOVERY_INTERVAL_SECS=600
REFRESH_INTERVAL_SECS=30
POOL_PUBLISH_INTERVAL_SECS=2
POOL_STATE_REFRESH_CONCURRENCY=8
LEDGER_WATCHER_ENABLED=true
LEDGER_POLL_SECS=0.1
LEDGER_MAX_CATCHUP=32
LEDGER_MAX_TOUCHED_REFRESH=64
FETCH_PIPELINE_ENABLED=1
FETCH_WORKER_COUNT=8
FETCH_HIGH_QUEUE_CAPACITY=512
FETCH_STATS_INTERVAL_SECS=60
AQUARIUS_HYDRATE_CONCURRENCY=16
HORIZON_URL=https://horizon.stellar.org
# SOROSWAP_FACTORY_CONTRACT=C...
# COMET_FACTORY=C...
# COMET_EXTRA_POOLS=C...,C...
COMET_FACTORY_EVENTS_LEDGER_WINDOW=50000
# SUSHI_DISCOVERY_RPC=https://your-sushi-discovery-rpc.example.com

# API process and routing. Set the deployed contract to enable /build_tx.
LISTEN_ADDR=127.0.0.1:3100
AGGREGATOR_CONTRACT=CHANGE_ME
SPLIT_THRESHOLD_BPS=5
SPLIT_COMPETITIVE_DELTA_BPS=50
MIN_SPLIT_FRACTION_BPS=5
MAX_SPLITS=3
PATH_FINDER_MAX_HOPS=3
PATH_FINDER_MAX_MULTI_HOP_PATHS=50
PATH_FINDER_MAX_DIRECT_PATHS=0
QUOTE_RPC_HYDRATE_ENABLED=false
QUOTE_HYDRATE_MAX_POOLS=12
QUOTE_ON_CHAIN_VALIDATE=false
INSTRUCTION_LEEWAY=100000000
TOKEN_LOGO_DIR=data/logos
TOKEN_LOGO_BASE_URL=https://api.lumagg.xyz/logos
# TOKEN_LOGO_LIST_URLS=https://example.com/token-list.json

# API access control. Comma-separate multiple values; empty means disabled.
LUMAGG_PARTNER_API_KEYS=
QUOTE_RATE_LIMIT_BYPASS_IPS=

# Optional order/indexer endpoints. Leave unset unless those components exist.
# ESCROW_CONTRACT=C...
# INDEXER_DB_PATH=/var/lib/lumagg/indexer.sqlite
# PRICE_DB_PATH=/var/lib/lumagg/prices.sqlite
# PRICE_SAMPLER=1
PRICE_SAMPLE_SECS=600
PRICE_SAMPLE_TOKEN_LIMIT=30
# PRICE_RETENTION_DAYS=90

# Optional monitoring and alerts. Keep secrets outside version control.
TELEGRAM_ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_PRIMARY_API_PORT=3100
TELEGRAM_HEARTBEAT_INTERVAL_SECS=600
MONITOR_API_HEALTH_URL=http://127.0.0.1:3100/api/v1/health
# MAINNET_RPC_REF_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
QUOTE_REDIS_MISS_ALERT_MIN=12
QUOTE_REDIS_MISS_ALERT_RATIO_BPS=3000
