# Shared by market-data-worker and api-server.
RPC_URL=https://your-stellar-rpc.example.com
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# Configure the same Redis URL for the worker and every API replica.
# Percent-encode special characters in the password.
SNAPSHOT_BACKEND=redis
SNAPSHOT_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/
SNAPSHOT_REDIS_CHANNEL=lumagg:snapshot:events
SNAPSHOT_REDIS_KEEP_LATEST=10

# Market-data worker.
DISCOVERY_INTERVAL_SECS=600
POOL_PUBLISH_INTERVAL_SECS=2
POOL_STATE_REFRESH_CONCURRENCY=8
FETCH_PIPELINE_ENABLED=1
FETCH_WORKER_COUNT=8
FETCH_HIGH_QUEUE_CAPACITY=512

# API routing. Set the deployed contract to enable /build_tx.
AGGREGATOR_CONTRACT=CHANGE_ME
SNAPSHOT_POLL_INTERVAL_MS=1000
SPLIT_THRESHOLD_BPS=5
SPLIT_COMPETITIVE_DELTA_BPS=50
MIN_SPLIT_FRACTION_BPS=5
MAX_SPLITS=3
PATH_FINDER_MAX_HOPS=3
PATH_FINDER_MAX_MULTI_HOP_PATHS=50
PATH_FINDER_MAX_DIRECT_PATHS=0
QUOTE_RPC_HYDRATE_ENABLED=false
QUOTE_HYDRATE_MAX_POOLS=12
