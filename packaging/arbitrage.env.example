# Quote service and Soroban RPC. Multiple quote URLs are used round-robin.
ARB_QUOTE_API_URLS=http://127.0.0.1:3100,http://127.0.0.1:3101
RPC_URL=https://your-stellar-rpc.example.com

# On-chain contracts and assets. Contract IDs use the C... form.
ARB_AGGREGATOR_CONTRACT=CHANGE_ME
# Optional: keep principal in an allowlisted vault instead of caller wallets.
# ARB_VAULT_CONTRACT=CHANGE_ME
ARB_BRIDGE_TOKENS=CHANGE_ME

# Keep caller secrets outside this file, one S... secret per line (chmod 600).
ARB_CALLER_SECRETS_FILE=/etc/lumagg/arbitrage-callers

# Safe initial mode: scan quotes only. See the deployment guide before changing.
ARB_BUILD_TX=0
ARB_SUBMIT_TX=0
ARB_DRY_RUN=1

ARB_PROBE_AMOUNT_IN=100000000
# Default post-fee net floor (base units, 7 decimals). Prefer per-base overrides.
ARB_MIN_PROFIT=80000
# ARB_MIN_PROFIT_XLM=80000
# ARB_MIN_PROFIT_USDC=30000
# USDC units per 1.0 XLM (7 decimals) — converts Soroban XLM fees for USDC gates.
# ARB_XLM_USDC_PRICE_E7=3000000
ARB_SLIPPAGE_BPS=0
ARB_MAX_HOPS=2
ARB_MAX_SPLITS=1
ARB_SCAN_INTERVAL_MS=500
ARB_ITEM_GAP_MS=10
ARB_WORKER_COUNT=4
ARB_OPTIMIZE_AMOUNT=1
ARB_MAX_AMOUNT_IN=5000000000
ARB_SAMPLE_COUNT=10
ARB_ON_CHAIN_VALIDATE=0
ARB_POLL_TX=0
